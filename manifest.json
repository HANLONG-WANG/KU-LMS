{
  "manifest_version": 3,
  "name": "KU-LMS",
  "description": "为关西大学 KU-LMS 提供现代界面、课程大纲入口和持久化课程 TODO，支持通过 Google Drive 在多台电脑间同步待办。",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon128.png"
      ],
      "matches": [
        "https://kulms.tl.kansai-u.ac.jp/*",
        "https://syllabus3.jm.kansai-u.ac.jp/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://kulms.tl.kansai-u.ac.jp/webclass/*",
    "https://syllabus3.jm.kansai-u.ac.jp/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_title": "KU-LMS",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kulms.tl.kansai-u.ac.jp/webclass/*"
      ],
      "css": [
        "src/content/critical.css",
        "src/shared/todo-ui.css"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/todo-client.js",
        "src/shared/todo-ui.js",
        "src/content/runtime/constants.js",
        "src/content/runtime/state.js",
        "src/content/runtime/routes.js",
        "src/content/utils/core.js",
        "src/content/parsers/auth.js",
        "src/content/parsers/shared.js",
        "src/content/parsers/home.js",
        "src/content/parsers/course.js",
        "src/content/parsers/notifications.js",
        "src/content/parsers/messages.js",
        "src/content/parsers/manual.js",
        "src/content/render/shared.js",
        "src/content/render/auth.js",
        "src/content/render/home.js",
        "src/content/render/course.js",
        "src/content/render/notifications.js",
        "src/content/render/messages.js",
        "src/content/render/manual.js",
        "src/content/hydrate/auth.js",
        "src/content/hydrate/shared.js",
        "src/content/services/documents.js",
        "src/content/services/cache.js",
        "src/content/services/timeline.js",
        "src/content/services/syllabus.js",
        "src/content/services/refresh.js",
        "src/content/services/all-upcoming.js",
        "src/content/services/todo.js",
        "src/content/services/course-todo.js",
        "src/content/services/task-completion.js",
        "src/content/runtime/boot-kulms.js",
        "src/content/main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://syllabus3.jm.kansai-u.ac.jp/syllabus/*"
      ],
      "css": [
        "src/content/critical.css"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/runtime/constants.js",
        "src/content/runtime/state.js",
        "src/content/runtime/routes.js",
        "src/content/utils/core.js",
        "src/content/parsers/auth.js",
        "src/content/parsers/shared.js",
        "src/content/parsers/home.js",
        "src/content/parsers/course.js",
        "src/content/parsers/notifications.js",
        "src/content/parsers/messages.js",
        "src/content/parsers/manual.js",
        "src/content/parsers/syllabus.js",
        "src/content/render/shared.js",
        "src/content/render/auth.js",
        "src/content/render/home.js",
        "src/content/render/course.js",
        "src/content/render/notifications.js",
        "src/content/render/messages.js",
        "src/content/render/manual.js",
        "src/content/render/syllabus.js",
        "src/content/hydrate/auth.js",
        "src/content/hydrate/shared.js",
        "src/content/hydrate/syllabus.js",
        "src/content/services/documents.js",
        "src/content/services/cache.js",
        "src/content/services/timeline.js",
        "src/content/services/syllabus.js",
        "src/content/services/refresh.js",
        "src/content/runtime/boot-syllabus.js",
        "src/content/syllabus-main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "oauth2": {
    "client_id": "1044365962804-qk6i9f2ka2n9dphhsggmnv7ij63ougd9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
