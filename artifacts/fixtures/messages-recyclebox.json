"<html xmlns=\"http://www.w3.org/1999/xhtml\" data-ku-redesign-booted=\"true\"><head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta http-equiv=\"Content-Style-Type\" content=\"text/css\">\n  <meta http-equiv=\"Content-Script-Type\" content=\"text/javascript\">\n\n<link type=\"text/css\" href=\"/webclass/css/basestyle.css\" rel=\"stylesheet\">\n<link type=\"text/css\" href=\"/webclass/css/popup_personaltools.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/webclass/css/transitional.css?time=1773706658\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/webclass/css/message.css?time=%2Fopt%2Fwebclass%2Flms%2Fwebclass%2Fcss%2Fmessage.css\">\n<style type=\"text/css\">\na{ text-decoration: underline; color: #1365b5;} th {\n\tbackground-color: #4682b4 !important;\n}\n\n.bgc_main {\n    background-color: #4682b4 !important;\n    color: #fff;\n}\n</style>\n\n\n<style type=\"text/css\">\nth {\n\tfont-weight : normal;\n}\ntable.editinfo {\n\tmargin : 1em 0;\n\twidth : auto;\n\tborder-collapse : collapse;\n}\ntable.editinfo caption{\n\tmargin-top : 1em;\n}\ntable.editinfo th {\n\tpadding : 0.5em 0.5em;\n\twidth : 10em;\n\ttext-align : right;\n\tborder-style : solid;\n\tborder-width : 1px;\n\tborder-color : #ffffff;\n}\ntable.editinfo td {\n\tpadding : 0.4em;\n\tbackground-color : #ffffff;\n\tborder-style : solid;\n\tborder-width : 1px;\n\tborder-color : #ffffff;\n}\ntable.editinfo td.attention {\n\tfont-size : 12pt;\n\ttext-align : center;\n}\n\ntable.editinfo input {\n\twidth : 20em;\n}\n\ntable.editinfo tr.opsection input {\n\twidth : auto;\n\tpadding : 0.2em 0.5em;\n}\n\ntable.editinfo tr.opsection td{\n\tbackground-color : #e1e1e1;\n\tborder-color : #ffffff;\n\n\tpadding : 1em;\n\ttext-align : center;\n}\n\n\n.msg .header_compose td {\n\tpadding: 0.3em 0.3em 0.3em 1em;\n}\n\n.msg .actions input {\n\tfont-size: 1.1em;\n\tmargin-right: 1em;\n}\n\n</style>\n\n<title>メッセージ - 関大LMS</title>\n\n<script type=\"text/javascript\">\nvar urlStore = '';\nfunction changeUser() {\n    if (urlStore !== '') {\n        document.condition.action = urlStore;\n    }\n\tdocument.condition.submit();\n}\nfunction searchbyname() {\n\tdocument.condition.searchmode.value = \"searchbyname\";\n\tchangeUser();\n}\n\nfunction changePage(jumpto) {\n    if (urlStore !== '') {\n        document.condition.action = urlStore;\n    }\n    document.condition.pagejumpto.value = jumpto;\n\tdocument.condition.submit();\n}\n\nfunction isMessageSelected() {\n\tvar num_checkbox = document.condition.num_cboxes.value;\n\tfor(i=0; i<num_checkbox; i++){\n\t\tif(document.condition.elements[ \"id[\" + i + \"]\"].checked) {\n\t\t\treturn true;\n\t\t}\n\t}\n\treturn false;\n}\nfunction openMsgDownload(openurl) {\n\tif(!isMessageSelected()) {\n\t\talert('メッセージを選択してください');\n\t\treturn false;\n\t}\n\n    if (urlStore === '') {\n        urlStore = document.condition.action;\n    }\n\tdocument.condition.target=\"\";\n\tdocument.condition.action=openurl;\n}\n\nfunction deleteMessage(openurl) {\n    if (urlStore === '') {\n        urlStore = document.condition.action;\n    }\n\tdocument.condition.target=\"\";\n\tdocument.condition.action=openurl;\n}\n\nfunction returnMessage(openurl) {\n    if (urlStore === '') {\n        urlStore = document.condition.action;\n    }\n\tdocument.condition.target=\"\";\n\tdocument.condition.action=openurl;\n}\n\n\tfunction filedownload(openurl) {\n\t\tw = window.open(openurl, \"download\",\n\t\t\t\t\"toolbar=no,location=no,directories=no,status=yes,menubar=no,scrollbars=yes,resizable=yes,width=320,height=250\");\n\t\tw.window.focus();\n\t}\n\n\tfunction idmanagerOpen(file_name) {\n\t\tw = window.open(file_name, \"idmanagerWindow\", \"toolbar=no, location=no,directories=no,status=no,menubar=no,scrollbars=no,resizable=yes,width=650,height=400\");\n\t\tw.window.focus();\n\t}\n\n\tfunction sortMessageListTable(column) {\n\t\tdocument.condition.msgtable_sortorder.value = column;\n\t\tdocument.condition.submit();\n\t}\n\tfunction selectAllCheckRecipients(idname){\n\t\tvar num_checkbox;\n\t\tvar ischecked = document.condition.autochecker.checked;\n\t\tnum_checkbox = document.condition.num_cboxes.value;\n\t\tfor(i=0; i<num_checkbox; i++){\n\t\t\tdocument.condition.elements[ idname + \"[\" + i + \"]\"].checked = ischecked;\n\t\t}\n\t}\n\n// -->\n</script>\n\n\n<script id=\"picviewer-page-script\">(function(messageID){\n                var frameID=Math.random();\n                var frames={\n                    top:window.top,\n                };\n\n                window.addEventListener('message',function(e){\n                    var data=e.data;\n                    if( !data || !data.messageID || data.messageID != messageID )return;//通信ID认证\n                    var source=e.source;\n                    if(source===window || source===unsafeWindow){//来自contentscript,发送出去,或者干嘛。\n                        if(data.to){\n                            data.from=frameID;\n                            frames[data.to].postMessage(data,'*');\n                        }else{\n                            switch(data.command){\n                                case 'getIframeObject':{\n                                    var frameWindow=frames[data.windowId];\n                                    var iframes=document.getElementsByTagName('iframe');\n                                    var iframe;\n                                    var targetIframe;\n                                    for(var i=iframes.length-1 ; i>=0 ; i--){\n                                        iframe=iframes[i];\n                                        if(iframe.contentWindow===frameWindow){\n                                            targetIframe=iframe;\n                                            break;\n                                        };\n                                    };\n                                    var cusEvent=document.createEvent('CustomEvent');\n                                    cusEvent.initCustomEvent('pv-getIframeObject',false,false,targetIframe);\n                                    document.dispatchEvent(cusEvent);\n                                }break;\n                            };\n                        };\n\n                    }else{//来自别的窗口的，contentscript可以直接接收，这里保存下来自的窗口的引用\n                        frames[data.from]=source;\n                    };\n                },true)\n            })(\"pv-0.5106795670312598\")</script></head>\n<body>\n<a href=\"javascript:window.close();\" class=\"uppernavi\">» このウィンドウを閉じる</a>\n<h1 class=\"pkgtitle bgc_main\">メッセージ</h1>\n<div class=\"navi\">\n<dl>\n  <dt class=\"bgc_main\">メッセージ</dt>\n    <dd><a href=\"/webclass/msg_editor.php?msgappmode=editmsg&amp;acs_=e6817634\">» メッセージ作成</a></dd>\n    <dd><a href=\"/webclass/msg_editor.php?msgappmode=inbox&amp;acs_=e6817634\">» 受信箱</a></dd>\n    <dd><a href=\"/webclass/msg_editor.php?msgappmode=outbox&amp;acs_=e6817634\">» 送信済箱</a></dd>\n    <dd class=\"active\"><a href=\"/webclass/msg_editor.php?msgappmode=recyclebox&amp;acs_=e6817634\">» ゴミ箱</a></dd>\n  <dt class=\"bgc_main\">お知らせ</dt>\n    <dd><a href=\"/webclass/information.php/?acs_=e6817634\">» 一覧</a></dd>\n</dl>\n</div>\n<div class=\"content\">\n\n<div style=\"margin: 1em 0;\">\n</div>\n<div style=\"margin: 1em 0;\" class=\"msg\">\n<h3>ゴミ箱</h3><div>ここでさらに削除したメッセージは、復元できなくなります。</div><br><form method=\"POST\" action=\"/webclass/msg_editor.php?msgappmode=recyclebox&amp;acs_=e6817634&amp;page=-1\" name=\"condition\" enctype=\"multipart/form-data\" autocomplete=\"off\"><table align=\"center\" border=\"0\" width=\"100%\"><tbody><tr><td><input type=\"submit\" name=\"RETURN_SELECTED\" value=\"元に戻す\" onclick=\"javascript:returnMessage('/webclass/msg_editor.php?msgappmode=recyclebox&amp;acs_=e6817634&amp;page=-1&amp;sort=date_desc')\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type=\"submit\" name=\"COMFIRM_SELECTED\" value=\"削除\" onclick=\"javascript:deleteMessage('/webclass/msg_editor.php?msgappmode=recyclebox&amp;acs_=e6817634&amp;page=-1&amp;sort=date_desc')\"><input type=\"submit\" name=\"UNSET_UNREADFLAG\" value=\"既読にする\" onclick=\"javascript:deleteMessage('/webclass/msg_editor.php?msgappmode=recyclebox&amp;acs_=e6817634&amp;page=-1&amp;sort=date_desc')\">&nbsp;&nbsp;&nbsp;&nbsp;<input type=\"submit\" name=\"downloadmsg\" value=\"ダウンロード\" onclick=\"return openMsgDownload('/webclass/msg_down.php?acs_=e6817634')\">&nbsp;</td><td nowrap=\"\" align=\"right\"><input type=\"hidden\" name=\"pagejumpto\" value=\"\"><font size=\"3\">&lt;&lt;&nbsp;&nbsp;&lt;前へ</font><font size=\"3\">&nbsp;&nbsp;&nbsp;<b>0</b>&nbsp;/0&nbsp;&nbsp;&nbsp;</font><font size=\"3\">次へ&gt;&nbsp;&nbsp;&gt;&gt;</font></td></tr></tbody></table>\t\t\t\t\t\t<table id=\"MsgBox\" border=\"0\" width=\"100%\" cellpadding=\"0\"><tbody><tr><td bgcolor=\"#EEEEEE\">\n\t\t\t<table id=\"MsgListTable\" width=\"100%\" cellspacing=\"1\" cellpadding=\"3\" style=\"table-layout: fixed;\">\n\t\t\t<thead>\n\t\t\t\t<tr>\n\t\t\t\t<th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\" width=\"25\"><span class=\"size3\"><input type=\"checkbox\" name=\"autochecker\" value=\"\" onclick=\"return selectAllCheckRecipients('id')\"></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\"><span class=\"size3\"><font color=\"#FFFFFF\">差出人</font><a href=\"javascript:sortMessageListTable('from')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('from_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\"><span class=\"size3\"><font color=\"#FFFFFF\">ユーザID</font><a href=\"javascript:sortMessageListTable('from_id')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('from_id_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\"><span class=\"size3\"><font color=\"#FFFFFF\">宛先</font><a href=\"javascript:sortMessageListTable('to')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('to_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\"><span class=\"size3\"><font color=\"#FFFFFF\">件名</font><a href=\"javascript:sortMessageListTable('subject')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('subject_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\"><span class=\"size3\"><font color=\"#FFFFFF\">添付ファイル</font><a href=\"javascript:sortMessageListTable('attachment')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('attachment_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th><th nowrap=\"\" class=\"bgc_main\" style=\"text-align:center;\" width=\"105\"><span class=\"size3\"><font color=\"#FFFFFF\">日付</font><a href=\"javascript:sortMessageListTable('date')\" title=\"昇順にソート\"><span class=\"sorticon\">▲</span></a><a href=\"javascript:sortMessageListTable('date_desc')\" title=\"降順でソート\"><span class=\"sorticon\">▼</span></a></span></th>\t\t\t\t</tr>\n\t\t\t</thead>\n\t\t\t</table>\n\t\t\t</td></tr></tbody></table>\n\t\t\t<input type=\"hidden\" name=\"msgtable_sortorder\" value=\"date_desc\">\n\t\t\t<input type=\"hidden\" name=\"num_cboxes\" value=\"0\">\n\t\t\t\n</form></div>\n</div>\n\n\n</body></html>"