<script>
    var courseLearningLayoutModalTargetList  = JSON.parse(document.getElementById('courseLearningLayoutModalTargetList').innerHTML);
    var sessionTimer;
    function updateSession(){
        var ajaxrequest_updateSession = '/webclass/session.php/keep';
        $.ajax({
            url: ajaxrequest_updateSession,
            data : {
            },
            cache : false,
            type : "GET",
            success: function(data) {

            }
        });
        setTimeout(updateSession, sessionTimer);
    }


    function showCourseLearningLayoutModal(modal_id) {
        if (courseLearningLayoutModalTargetList.length){
            for(var index = 0; index < courseLearningLayoutModalTargetList.length; index++) {
                if ('#' + courseLearningLayoutModalTargetList[index].modal_id === modal_id){

                    $('#courseLearningLayoutModal')
                        .find('.modal-body-frame').attr('src', courseLearningLayoutModalTargetList[index].url).end()
                        .find('.modal-title').html(courseLearningLayoutModalTargetList[index].label).end()
                        .modal();
                    break;
                }
            }
        }
    }

    function loadedIframe() {
        var iframe = document.getElementById('ip-iframe');
        if (iframe && iframe.contentWindow) {

            var observer = new MutationObserver(function () {
                adjustIframeHeight();
            });

            observer.observe(iframe.contentWindow.document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                characterData: true,
            });
            adjustIframeHeight();
        }
    }

    function adjustIframeHeight() {
        var iframe = document.getElementById('ip-iframe');
        if (iframe && iframe.contentWindow) {
            var iframe_height = $(iframe).contents().height() + 'px';
            $(iframe).attr('height', iframe_height);
        }
    }

    $(function () {
        sessionTimer = 1200000;
        updateSession();

        $('.showCourseLearningLayoutModalButton').on('click',function (e) {
            e.preventDefault();
            showCourseLearningLayoutModal($(this).attr('href'));
        });

        showCourseLearningLayoutModal(location.hash);

        $('.showInIframeButton').on('click', function (e) {
            e.preventDefault();

            var iframe = $('<iframe id="ip-iframe" src="" frameborder="0" scrolling="no" style="width: 1px;min-width: 100%;" onload="loadedIframe()" >')
                .attr('src', $(this).attr('href'));
            $('#js-main').empty().append(iframe);
            adjustIframeHeight();

            $('#menu li.active').removeClass('active');
            $(this).closest('.dropdown').addClass('active');
        });
    });
