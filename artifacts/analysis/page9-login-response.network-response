      $.overlay({object: loginFeedback});
      $.showOverlay({
        speed: 150,
        callback: function() {
        }});
    }
    function initLoginButton() {
      $.initOverlay({});

      var loginButtonContainer = $("#LoginBtn").parent();

      var loginButtonReplaceHtml = '<br><img src="./images/loading.gif"> 正在处理登录。';

      $(document.login).on('submit',function(){
        $("#LoginBtn").remove();
        loginButtonContainer.append(loginButtonReplaceHtml);

        setTimeout(function(){
