    function openMessage(url) {
      w = window.open(url, "msgeditor", "toolbar=no, location=no,directories=no,status=yes,menubar=no,scrollbars=yes,resizable=yes,width=820,height=650");
      if(w !== null) {
        w.window.focus();
      }
    }
